RISK_APP_NAME=sub2api-risk
RISK_ENV=development
RISK_LISTEN_ADDR=:8091
AUX_IMAGE_TAG=aux-YYYYMMDD.N

# Reuse the same PostgreSQL / Redis instances from sub2api-ha.
RISK_DATABASE_URL=postgres://CHANGE_ME_DATABASE_USER:CHANGE_ME_STRONG_DATABASE_PASSWORD@postgres:5432/CHANGE_ME_DATABASE_DBNAME?sslmode=disable
RISK_REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0

# Read-only mounted log directory from sub2api-ha or host.
RISK_LOG_PATH=/risk/logs

# Phase 1 defaults to read-only analytics mode.
RISK_READ_ONLY_MODE=true

# Refresh pipeline configuration.
# Source table/view must expose:
# - user_id
# - api_key_id
# - model_name
# - client_ip
# - cost
# - occurred_at
RISK_EMBED_TOKEN=CHANGE_ME_EMBED_TOKEN
RISK_ENABLE_REFRESH_API=true
RISK_REFRESH_TOKEN=CHANGE_ME_REFRESH_TOKEN
RISK_REFRESH_ON_START=false
RISK_SOURCE_TABLE=public.request_logs

# Rule thresholds.
RISK_THRESHOLD_BURST_REQUESTS_1H=100
RISK_THRESHOLD_COST_SPIKE_RATIO=3
RISK_THRESHOLD_COST_SPIKE_FLOOR_1H=10
RISK_THRESHOLD_UNIQUE_IP_24H=5

# Optional compose-level passthrough variables if you want to keep the same style as sub2api-ha.
DATABASE_URL=postgres://CHANGE_ME_DATABASE_USER:CHANGE_ME_STRONG_DATABASE_PASSWORD@postgres:5432/CHANGE_ME_DATABASE_DBNAME?sslmode=disable
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0
