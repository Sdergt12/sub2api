FROM node:22-alpine AS build

ARG VITE_API_BASE_URL=/external/sign-api/api/sign
ARG VITE_BOOTSTRAP_URL=/external/sign-api/embed/bootstrap
ARG VITE_BASE_PATH=/external/sign/

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_BOOTSTRAP_URL=${VITE_BOOTSTRAP_URL}
ENV VITE_BASE_PATH=${VITE_BASE_PATH}

WORKDIR /src/web

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/web/dist /usr/share/nginx/html/external/sign

EXPOSE 4174
